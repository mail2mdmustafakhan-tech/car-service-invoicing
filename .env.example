# Optional settings. Copy this file to ".env" only if you need to change
# something -- the defaults are fine for a single office PC.
#
# Everything about the business itself (name, VAT rate, invoice numbering)
# is configured on the Settings page inside the application, not here.

# Where the database file lives.
CARSERVICE_DB=data/carservice.db

# Which address to listen on.
#   127.0.0.1  this computer only (the default, and the safest)
#   0.0.0.0    any computer on the office network can reach it
CARSERVICE_HOST=127.0.0.1

# Which port to serve on. Change it if something else already uses 8000.
CARSERVICE_PORT=8000
