# The live database and its write-ahead log. Never commit these: they hold
# real customer data, and a copy in Git would be a copy you cannot delete.
data/
*.db
*.db-wal
*.db-shm
*.sqlite3
backups/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local configuration
.env

# Notes left in one particular working copy on one particular machine. They
# name local drive paths, so they belong to that machine and not to the
# project everybody else clones.
START-HERE.txt
setup-git-once.bat

# The walkthrough recording. Useful to have beside the code, too big to
# be worth git's attention -- git stores a whole new copy of a binary
# every time it changes.
*.mp4
